# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.
# ⚠️ FILE NÀY ĐƯỢC GIT TRACK — chỉ để placeholder ở đây, KHÔNG BAO GIỜ dán key thật.
#    Key thật chỉ nằm trong .env (đã gitignore).
GEMINI_API_KEY=

# --- Qdrant (DEC-018: dùng Qdrant Cloud free 1GB, không dựng Docker local) ---
# QDRANT_URL là REST endpoint của cluster, KHÔNG phải URL trang dashboard.
# Đúng:  https://<cluster-id>.<region>.cloud.qdrant.io:6333
# Sai:   https://cloud.qdrant.io/accounts/<...>/clusters/<...>/overview
# API key chỉ hiện MỘT lần lúc tạo cluster — copy ngay, mất là phải sinh lại.
QDRANT_URL=
QDRANT_API_KEY=
# Dự phòng offline (docker-compose up -d): QDRANT_URL=http://localhost:6333, API key để trống.
