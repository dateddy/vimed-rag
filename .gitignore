# Secrets & env
.env
.venv/
venv/

# Data (không commit dữ liệu thô/đã xử lý)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# NGOẠI LỆ CÓ CHỦ Ý (B5) — 8,5 KB, là ĐẦU VÀO BẮT BUỘC của
# `scripts/build_risk_coverage.py`, mà biểu đồ nó sinh ra (`docs/risk-coverage.png`)
# mang claim chính của đề tài. Không whitelist thì clone sạch KHÔNG dựng lại được
# biểu đồ đó — phải chạy lại lô ~45 phút + tốn credit trước đã.
# ⛔ KHÔNG whitelist `runs.jsonl` (2,3 MB): nó chỉ dùng để ĐỐI CHỨNG CHÉO, và
# script đã tự degrade kèm thông báo khi thiếu (build_risk_coverage.py:361).
!data/processed/calibration_scores.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# Qdrant local storage
qdrant_storage/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Claude Code — per-máy, không share (settings.json thì CÓ commit)
.claude/settings.local.json
